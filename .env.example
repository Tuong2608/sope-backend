# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
MYSQL_ROOT_PASSWORD=your_root_password_here
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# Runtime and service URLs
PORT=8080
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHATBOT_URL=http://localhost:8000
CHATBOT_SECRET=change_me_to_match_chatbot_service_key
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=30s

# JWT Configuration
APP_JWT_SECRET=your_base64_encoded_jwt_secret_here

# Admin Account Configuration
APP_ADMIN_PASSWORD=your_secure_admin_password_here

# VNPAY Sandbox Configuration
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here

# MoMo Sandbox Configuration
MOMO_PARTNER_CODE=your_momo_partner_code_here
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
