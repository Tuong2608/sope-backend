# Database
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=sope
MYSQL_PASSWORD=replace_with_a_long_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=sope
SPRING_DATASOURCE_PASSWORD=replace_with_a_long_database_password
JPA_DDL_AUTO=update
FLYWAY_ENABLED=true
SPRING_JPA_SHOW_SQL=false

# Runtime and service URLs
PORT=8080
APP_FRONTEND_URL=http://localhost:3000
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHATBOT_URL=http://localhost:8000
CHATBOT_SECRET=change_me_to_match_chatbot_service_key
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=30s
FORWARD_HEADERS_STRATEGY=framework
SHUTDOWN_TIMEOUT=30s

# Authentication
APP_JWT_SECRET=your_base64_encoded_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=your_secure_admin_password_here
APP_ADMIN_EMAIL=admin@example.com

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
EMAIL_VERIFICATION_EXPIRATION_MINUTES=1440

# VNPAY Sandbox Configuration
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://YOUR_NGROK_DOMAIN/api/payment/vnpay/callback
VNPAY_IPN_URL=https://YOUR_NGROK_DOMAIN/api/payment/vnpay/ipn
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo Sandbox Configuration
MOMO_PARTNER_CODE=your_momo_partner_code_here
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://YOUR_NGROK_DOMAIN/api/payment/momo/callback
MOMO_IPN_URL=https://YOUR_NGROK_DOMAIN/api/payment/momo/ipn
MOMO_REQUEST_TYPE=captureWallet
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
